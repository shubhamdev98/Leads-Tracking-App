<%- include('layouts/header') %>

<div class="error-page-card card">
  <div class="error-status-code"><%= statusCode %></div>
  <h1 class="error-heading"><%= message %></h1>
  <p class="error-description">
    <% if (statusCode === 404) { %>
      The page or lead you requested does not exist or may have been removed.
    <% } else { %>
      An unexpected error occurred while processing your request. Please try again.
    <% } %>
  </p>

  <% if (typeof details !== 'undefined' && details) { %>
    <div class="error-details-box">
      <pre><code><%= JSON.stringify(details, null, 2) %></code></pre>
    </div>
  <% } %>

  <div class="error-actions">
    <a href="/leads" class="btn btn-primary">Return to Leads List</a>
  </div>
</div>

<%- include('layouts/footer') %>
