<%- include('../layouts/header') %>

<div class="breadcrumb">
  <a href="/leads">&larr; Back to Leads List</a>
</div>

<div class="form-page-layout">
  <div class="card form-card">
    <div class="form-header">
      <div class="form-header-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
      </div>
      <div>
        <h1 class="page-title">Create New Lead</h1>
        <p class="page-subtitle">Enter customer details to register and track a new sales opportunity.</p>
      </div>
    </div>

    <% if (errors.general) { %>
      <div class="alert alert-danger">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span><%= errors.general %></span>
      </div>
    <% } %>

    <form action="/leads/new" method="POST" class="standard-form" novalidate id="create-lead-form">
      <div class="form-group <%= errors.name ? 'has-error' : '' %>">
        <label for="name" class="form-label">Full Name <span class="required-star">*</span></label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          class="form-input" 
          placeholder="e.g. Sarah Connor" 
          value="<%= formData.name || '' %>"
          required
        >
        <% if (errors.name) { %>
          <span class="field-error"><%= errors.name %></span>
        <% } else { %>
          <span class="form-help">Enter the lead's full legal or business contact name.</span>
        <% } %>
      </div>

      <div class="form-row">
        <div class="form-group <%= errors.email ? 'has-error' : '' %>">
          <label for="email" class="form-label">Email Address <span class="required-star">*</span></label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-input" 
            placeholder="e.g. sarah.connor@example.com" 
            value="<%= formData.email || '' %>"
            required
          >
          <% if (errors.email) { %>
            <span class="field-error"><%= errors.email %></span>
          <% } else { %>
            <span class="form-help">Valid business or personal email address.</span>
          <% } %>
        </div>

        <div class="form-group <%= errors.phone ? 'has-error' : '' %>">
          <label for="phone" class="form-label">Phone Number <span class="required-star">*</span></label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            class="form-input" 
            placeholder="e.g. +1 (555) 234-5678" 
            value="<%= formData.phone || '' %>"
            required
          >
          <% if (errors.phone) { %>
            <span class="field-error"><%= errors.phone %></span>
          <% } else { %>
            <span class="form-help">Include country/area code if applicable.</span>
          <% } %>
        </div>
      </div>

      <div class="form-group <%= errors.status ? 'has-error' : '' %>">
        <label for="status" class="form-label">Pipeline Status</label>
        <div class="status-selector-grid">
          <% validStatuses.forEach(st => { %>
            <label class="status-radio-card <%= (formData.status || 'new') === st ? 'selected' : '' %>">
              <input 
                type="radio" 
                name="status" 
                value="<%= st %>" 
                <%= (formData.status || 'new') === st ? 'checked' : '' %>
              >
              <span class="status-badge status-<%= st %>">
                <span class="badge-dot"></span>
                <%= st.charAt(0).toUpperCase() + st.slice(1) %>
              </span>
            </label>
          <% }); %>
        </div>
        <% if (errors.status) { %>
          <span class="field-error"><%= errors.status %></span>
        <% } %>
      </div>

      <div class="form-actions">
        <a href="/leads" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary" id="btn-submit-lead">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>Create Lead</span>
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
