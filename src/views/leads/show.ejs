<%- include('../layouts/header') %>

<div class="breadcrumb">
  <a href="/leads">&larr; Back to Leads List</a>
</div>

<% if (typeof notification !== 'undefined' && notification) { %>
  <div class="alert alert-success">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
    <span><%= notification %></span>
  </div>
<% } %>

<div class="lead-detail-grid">
  <!-- Left Column: Lead Info & Contact Card -->
  <div class="lead-profile-card card">
    <div class="profile-header">
      <div class="lead-avatar avatar-large">
        <%= lead.name.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() %>
      </div>
      <div class="profile-title-area">
        <h1 class="lead-title" id="lead-name-heading"><%= lead.name %></h1>
        <div class="profile-badge-row">
          <span class="status-badge status-<%= lead.status %>" id="lead-status-badge">
            <span class="badge-dot"></span>
            <%= lead.status.charAt(0).toUpperCase() + lead.status.slice(1) %>
          </span>
          <span class="lead-id-tag">ID: <code><%= lead.id %></code></span>
        </div>
      </div>
    </div>

    <!-- Quick Status Changer -->
    <div class="quick-status-section">
      <label class="section-micro-label">Update Status</label>
      <form action="/leads/<%= lead.id %>/edit" method="POST" class="status-quick-form" id="quick-status-form">
        <input type="hidden" name="name" value="<%= lead.name %>">
        <input type="hidden" name="email" value="<%= lead.email %>">
        <input type="hidden" name="phone" value="<%= lead.phone %>">
        <select name="status" class="form-select status-select" onchange="this.form.submit()" id="select-lead-status">
          <% validStatuses.forEach(st => { %>
            <option value="<%= st %>" <%= lead.status === st ? 'selected' : '' %>>
              <%= st.charAt(0).toUpperCase() + st.slice(1) %>
            </option>
          <% }); %>
        </select>
      </form>
    </div>

    <div class="divider"></div>

    <!-- Contact & Meta Information -->
    <div class="detail-section">
      <h3 class="detail-section-title">Contact Information</h3>
      
      <div class="info-item">
        <div class="info-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </div>
        <div class="info-content">
          <span class="info-label">Email Address</span>
          <a href="mailto:<%= lead.email %>" class="info-value info-link" id="lead-email-value"><%= lead.email %></a>
        </div>
      </div>

      <div class="info-item">
        <div class="info-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </div>
        <div class="info-content">
          <span class="info-label">Phone Number</span>
          <a href="tel:<%= lead.phone %>" class="info-value info-link" id="lead-phone-value"><%= lead.phone %></a>
        </div>
      </div>

      <div class="info-item">
        <div class="info-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <div class="info-content">
          <span class="info-label">Created At</span>
          <span class="info-value">
            <%= new Date(lead.createdAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) %>
          </span>
        </div>
      </div>
    </div>

    <div class="card-footer-actions">
      <a href="/leads/<%= lead.id %>/edit" class="btn btn-secondary btn-block" id="btn-edit-lead-page">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        <span>Edit Lead Details</span>
      </a>

      <form action="/leads/<%= lead.id %>/delete" method="POST" onsubmit="return confirm('Delete this lead and all associated notes? This action cannot be undone.');">
        <button type="submit" class="btn btn-danger-outline btn-block" id="btn-delete-lead-detail">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          <span>Delete Lead</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Right Column: Notes & Activity -->
  <div class="lead-notes-area">
    <!-- Add Note Card -->
    <div class="card add-note-card" id="add-note-section">
      <div class="card-header-clean">
        <div class="header-with-badge">
          <h2 class="card-title">Lead Notes & Timeline</h2>
          <span class="count-pill"><%= notes.length %> <%= notes.length === 1 ? 'Note' : 'Notes' %></span>
        </div>
        <p class="card-subtitle">Keep track of conversations, follow-ups, qualification remarks, and call logs.</p>
      </div>

      <% if (typeof noteError !== 'undefined' && noteError) { %>
        <div class="alert alert-danger">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span><%= noteError %></span>
        </div>
      <% } %>

      <form action="/leads/<%= lead.id %>/notes" method="POST" class="add-note-form" id="add-note-form">
        <div class="form-group">
          <label for="note-content" class="sr-only">Add a note</label>
          <textarea 
            id="note-content" 
            name="content" 
            class="form-textarea" 
            rows="3" 
            placeholder="Write a note about this lead (e.g. Discussed pricing plan, client requested demo on Friday)..."
            required
          ></textarea>
        </div>
        <div class="note-form-actions">
          <button type="submit" class="btn btn-primary btn-sm" id="btn-submit-note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Add Note</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Notes List Feed -->
    <div class="notes-feed" id="notes">
      <% if (notes.length === 0) { %>
        <div class="card empty-notes-state">
          <div class="empty-icon-sm">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <h3 class="empty-title-sm">No notes recorded yet</h3>
          <p class="empty-sub-sm">Document your first touchpoint, discovery call or qualification summary above.</p>
        </div>
      <% } else { %>
        <% notes.forEach(note => { %>
          <div class="card note-item" id="note-<%= note.id %>">
            <div class="note-header">
              <div class="note-meta">
                <span class="note-author-pill">Staff Note</span>
                <span class="note-timestamp" title="<%= note.createdAt %>">
                  <%= new Date(note.createdAt).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }) %>
                </span>
              </div>
              <form action="/leads/<%= lead.id %>/notes/<%= note.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this note?');">
                <button type="submit" class="btn-icon btn-icon-xs btn-icon-danger" title="Delete note" id="btn-delete-note-<%= note.id %>">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
              </form>
            </div>
            <div class="note-body">
              <p class="note-text"><%= note.content %></p>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
