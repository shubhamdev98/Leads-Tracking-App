<%- include('../layouts/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Leads Management</h1>
    <p class="page-subtitle">Track, qualify, and convert customer leads with real-time updates</p>
  </div>
  <div class="page-actions">
    <a href="/leads/new" class="btn btn-primary" id="btn-add-lead-main">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <span>Add New Lead</span>
    </a>
  </div>
</div>

<!-- Stats Counter Cards -->
<div class="stats-grid">
  <div class="stat-card stat-total">
    <div class="stat-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Total Leads</span>
      <span class="stat-value"><%= stats.total %></span>
    </div>
  </div>

  <div class="stat-card stat-new">
    <div class="stat-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">New</span>
      <span class="stat-value"><%= stats.new %></span>
    </div>
  </div>

  <div class="stat-card stat-contacted">
    <div class="stat-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Contacted</span>
      <span class="stat-value"><%= stats.contacted %></span>
    </div>
  </div>

  <div class="stat-card stat-qualified">
    <div class="stat-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Qualified</span>
      <span class="stat-value"><%= stats.qualified %></span>
    </div>
  </div>

  <div class="stat-card stat-lost">
    <div class="stat-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
    </div>
    <div class="stat-info">
      <span class="stat-label">Lost</span>
      <span class="stat-value"><%= stats.lost %></span>
    </div>
  </div>
</div>

<!-- Search & Filter Controls -->
<div class="card filter-card">
  <form action="/leads" method="GET" class="filter-form" id="filter-form">
    <div class="search-input-wrapper">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        name="search" 
        id="search-input"
        class="form-input search-input" 
        placeholder="Search leads by name or email..." 
        value="<%= filters.search %>"
        autocomplete="off"
      >
      <% if (filters.search) { %>
        <a href="/leads?status=<%= filters.status %>" class="search-clear-btn" title="Clear search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </a>
      <% } %>
    </div>

    <div class="status-tabs">
      <a href="/leads?search=<%= encodeURIComponent(filters.search) %>&status=all" class="status-tab <%= filters.status === 'all' ? 'active' : '' %>">
        All
      </a>
      <a href="/leads?search=<%= encodeURIComponent(filters.search) %>&status=new" class="status-tab <%= filters.status === 'new' ? 'active' : '' %>">
        <span class="tab-dot dot-new"></span> New
      </a>
      <a href="/leads?search=<%= encodeURIComponent(filters.search) %>&status=contacted" class="status-tab <%= filters.status === 'contacted' ? 'active' : '' %>">
        <span class="tab-dot dot-contacted"></span> Contacted
      </a>
      <a href="/leads?search=<%= encodeURIComponent(filters.search) %>&status=qualified" class="status-tab <%= filters.status === 'qualified' ? 'active' : '' %>">
        <span class="tab-dot dot-qualified"></span> Qualified
      </a>
      <a href="/leads?search=<%= encodeURIComponent(filters.search) %>&status=lost" class="status-tab <%= filters.status === 'lost' ? 'active' : '' %>">
        <span class="tab-dot dot-lost"></span> Lost
      </a>
    </div>

    <input type="hidden" name="status" value="<%= filters.status %>">
    <button type="submit" class="btn btn-secondary btn-search" id="btn-submit-filter">Search</button>
  </form>
</div>

<!-- Leads List Card -->
<div class="card table-card">
  <% if (leads.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <line x1="17" y1="8" x2="23" y2="8"></line>
        </svg>
      </div>
      <h3 class="empty-title">No leads found</h3>
      <p class="empty-description">
        <% if (filters.search || (filters.status && filters.status !== 'all')) { %>
          No leads match your current search criteria. Try modifying your filters or clear them.
        <% } else { %>
          Get started by adding your first lead or click below to populate sample leads.
        <% } %>
      </p>
      <div class="empty-actions">
        <% if (filters.search || (filters.status && filters.status !== 'all')) { %>
          <a href="/leads" class="btn btn-secondary">Clear Filters</a>
        <% } %>
        <a href="/leads/new" class="btn btn-primary" id="btn-empty-add-lead">Add First Lead</a>
      </div>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="leads-table">
        <thead>
          <tr>
            <th>Lead</th>
            <th>Contact</th>
            <th>Status</th>
            <th>Created</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% leads.forEach(lead => { %>
            <tr class="lead-row" id="lead-row-<%= lead.id %>">
              <td class="lead-info-col">
                <div class="lead-identity">
                  <div class="lead-avatar">
                    <%= lead.name.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() %>
                  </div>
                  <div>
                    <a href="/leads/<%= lead.id %>" class="lead-name-link" title="View details">
                      <%= lead.name %>
                    </a>
                    <span class="lead-id-sub">ID: <%= lead.id.substring(0, 8) %>...</span>
                  </div>
                </div>
              </td>
              <td class="lead-contact-col">
                <div class="contact-line">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                  <a href="mailto:<%= lead.email %>" class="contact-link"><%= lead.email %></a>
                </div>
                <div class="contact-line">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                  <a href="tel:<%= lead.phone %>" class="contact-link"><%= lead.phone %></a>
                </div>
              </td>
              <td class="lead-status-col">
                <span class="status-badge status-<%= lead.status %>">
                  <span class="badge-dot"></span>
                  <%= lead.status.charAt(0).toUpperCase() + lead.status.slice(1) %>
                </span>
              </td>
              <td class="lead-date-col">
                <span class="date-text" title="<%= lead.createdAt %>">
                  <%= new Date(lead.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </span>
                <span class="time-sub">
                  <%= new Date(lead.createdAt).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' }) %>
                </span>
              </td>
              <td class="lead-actions-col text-right">
                <div class="actions-group">
                  <a href="/leads/<%= lead.id %>" class="btn-icon" title="View Lead & Notes" id="btn-view-<%= lead.id %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </a>
                  <a href="/leads/<%= lead.id %>/edit" class="btn-icon" title="Edit Lead" id="btn-edit-<%= lead.id %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                  </a>
                  <form action="/leads/<%= lead.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete lead \'<%= lead.name %>\'? All associated notes will also be deleted.');">
                    <button type="submit" class="btn-icon btn-icon-danger" title="Delete Lead" id="btn-delete-<%= lead.id %>">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Footer -->
    <div class="pagination-wrapper">
      <div class="pagination-info">
        Showing <%= leads.length > 0 ? ((pagination.page - 1) * pagination.limit) + 1 : 0 %> to 
        <%= Math.min(pagination.page * pagination.limit, pagination.total) %> of 
        <strong><%= pagination.total %></strong> leads
      </div>
      <% if (pagination.totalPages > 1) { %>
        <div class="pagination-controls">
          <% if (pagination.hasPrevPage) { %>
            <a href="/leads?page=<%= pagination.page - 1 %>&search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>" class="btn btn-secondary btn-sm">
              &larr; Previous
            </a>
          <% } else { %>
            <button class="btn btn-secondary btn-sm" disabled>&larr; Previous</button>
          <% } %>

          <div class="page-pills">
            <% for (let p = 1; p <= pagination.totalPages; p++) { %>
              <% if (p === 1 || p === pagination.totalPages || (p >= pagination.page - 1 && p <= pagination.page + 1)) { %>
                <a href="/leads?page=<%= p %>&search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>" class="page-pill <%= p === pagination.page ? 'active' : '' %>">
                  <%= p %>
                </a>
              <% } else if (p === pagination.page - 2 || p === pagination.page + 2) { %>
                <span class="page-ellipsis">&hellip;</span>
              <% } %>
            <% } %>
          </div>

          <% if (pagination.hasNextPage) { %>
            <a href="/leads?page=<%= pagination.page + 1 %>&search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>" class="btn btn-secondary btn-sm">
              Next &rarr;
            </a>
          <% } else { %>
            <button class="btn btn-secondary btn-sm" disabled>Next &rarr;</button>
          <% } %>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../layouts/footer') %>
